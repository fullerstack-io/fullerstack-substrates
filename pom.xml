<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.fullerstack</groupId>
  <artifactId>fullerstack-substrates</artifactId>
  <version>3.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Substrates (Java)</name>
  <description>Event-driven runtime implementation of Humainary Substrates API for Java 26
  </description>

  <url>https://github.com/fullerstack-io/fullerstack-substrates</url>

  <properties>
    <jmh.version>1.37</jmh.version>
    <!-- Java 26 (required for Substrates API) -->
    <java.version>26</java.version>
    <maven.compiler.source>26</maven.compiler.source>
    <maven.compiler.target>26</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Dependency Versions -->
    <substrates-api.version>3.0.0</substrates-api.version>
    <serventis-api.version>3.0.0</serventis-api.version>
    <junit.version>5.11.0</junit.version>
    <assertj.version>3.26.3</assertj.version>
    <mockito.version>5.15.2</mockito.version>

    <!-- Plugin Versions -->
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.1</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
  </properties>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>
        This implementation is based on the Humainary Substrates API designed by William Louth.
        Both this implementation and the Substrates API are licensed under Apache 2.0.
      </comments>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>fullerstack</id>
      <name>Fullerstack</name>
      <url>https://fullerstack.io/</url>
      <roles>
        <role>Implementation</role>
      </roles>
    </developer>
  </developers>

  <contributors>
    <contributor>
      <name>William Louth</name>
      <organization>Humainary</organization>
      <organizationUrl>https://humainary.io/</organizationUrl>
      <roles>
        <role>API Design</role>
        <role>Substrates Framework Creator</role>
      </roles>
    </contributor>
  </contributors>

  <scm>
    <connection>scm:git:git://github.com/fullerstack-io/fullerstack-substrates.git</connection>
    <developerConnection>scm:git:ssh://github.com:fullerstack-io/fullerstack-substrates.git
    </developerConnection>
    <url>https://github.com/fullerstack-io/fullerstack-substrates</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/fullerstack-io/fullerstack-substrates/issues</url>
  </issueManagement>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/fullerstack-io/fullerstack-substrates</url>
    </repository>
  </distributionManagement>

  <dependencies>
    <!-- Substrates API -->
    <dependency>
      <groupId>io.humainary.substrates</groupId>
      <artifactId>humainary-substrates-api</artifactId>
      <version>${substrates-api.version}</version>
    </dependency>

    <!-- Humainary Serventis API -->
    <dependency>
      <groupId>io.humainary.serventis</groupId>
      <artifactId>humainary-serventis-api</artifactId>
      <version>${serventis-api.version}</version>
    </dependency>

    <!-- Logging (SLF4J API only, implementation provided by consumer) -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.16</version>
    </dependency>

    <!-- Lombok (compile-time code generation) -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.34</version>
      <scope>provided</scope>
    </dependency>

    <!-- Vavr (functional data structures) -->
    <dependency>
      <groupId>io.vavr</groupId>
      <artifactId>vavr</artifactId>
      <version>0.10.4</version>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>1.15.11</version>
      <scope>test</scope>
    </dependency>

    <!-- LMAX Disruptor for benchmarking comparison -->
    <dependency>
      <groupId>com.lmax</groupId>
      <artifactId>disruptor</artifactId>
      <version>4.0.0</version>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <compilerArgs>
            <arg>--enable-preview</arg>
            <arg>--add-exports</arg>
            <arg>java.base/jdk.internal.vm.annotation=ALL-UNNAMED</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <argLine>
            --enable-preview
            -XX:+EnableDynamicAgentLoading
            -XX:-RestrictContended
            -Dnet.bytebuddy.experimental=true
            --add-opens java.base/java.lang=ALL-UNNAMED
            --add-opens java.base/java.util=ALL-UNNAMED
            --add-opens java.base/java.util.function=ALL-UNNAMED
            --add-opens java.management/javax.management=ALL-UNNAMED
            --add-opens java.management/javax.management.remote=ALL-UNNAMED
            --add-opens java.rmi/sun.rmi.transport=ALL-UNNAMED
          </argLine>
          <systemPropertyVariables>
            <!-- Configure Substrates API to use our FsCortexProvider implementation -->
            <io.humainary.substrates.spi.provider>io.fullerstack.substrates.FsCortexProvider
            </io.humainary.substrates.spi.provider>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
      </plugin>

      <!--
        EditorConfig Formatter (IntelliJ CE formatter via javalint).
        Plugin is configured but NOT bound to a build phase: running every
        mvn install / mvn deploy against the javalint rule set would gate
        publish on dev-style concerns. Lint is available on demand via
        ./scripts/format.sh (check flag) or mvn editorconfig-maven-plugin:check.
      -->
      <plugin>
        <groupId>org.ec4j.maven</groupId>
        <artifactId>editorconfig-maven-plugin</artifactId>
        <version>0.1.3</version>
        <configuration>
          <!-- Disable default linters, use javalint instead -->
          <linters>
            <linter>
              <id>org.ec4j.linters.TextLinter</id>
              <enabled>false</enabled>
            </linter>
            <linter>
              <id>org.ec4j.linters.XmlLinter</id>
              <enabled>false</enabled>
            </linter>
          </linters>
        </configuration>
        <dependencies>
          <!-- javalint: IntelliJ CE formatter with full ij_* EditorConfig support -->
          <dependency>
            <groupId>io.github.kamil-perczynski</groupId>
            <artifactId>javalint-ec4j-linter</artifactId>
            <version>1.3</version>
          </dependency>
        </dependencies>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <!-- Benchmarks are OFF by default: `mvn -Pbench package`.

         They used to be a main source root, so 1184 of the 1295 files in the published jar were
         benchmark classes (a 6.6 MB artifact, 91% harness), and jmh-core plus its annotation
         processor arrived as compile dependencies of every consumer. Downstream products embed
         this jar in production; a benchmark runner and a codegen processor have no business on
         that classpath, and consumers had started excluding them by hand.

         Everything the benchmarks need lives here and nowhere else: the source root, the JMH
         dependencies, the annotation processor, the uber-jar and its dependency staging. -->
    <profile>
      <id>bench</id>
      <properties>
        <!-- Under this profile the main jar carries the benchmark classes. Installing or
             deploying that would hand downstream products the very artifact this profile
             exists to keep them from getting, so make it impossible rather than a rule. -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.openjdk.jmh</groupId>
          <artifactId>jmh-core</artifactId>
          <version>${jmh.version}</version>
        </dependency>
        <dependency>
          <groupId>org.openjdk.jmh</groupId>
          <artifactId>jmh-generator-annprocess</artifactId>
          <version>${jmh.version}</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <version>${maven-compiler-plugin.version}</version>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>org.openjdk.jmh</groupId>
                  <artifactId>jmh-generator-annprocess</artifactId>
                  <version>${jmh.version}</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </plugin>

          <!-- Add JMH benchmark sources -->
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.5.0</version>
            <executions>
              <execution>
                <id>add-jmh-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>src/jmh/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- Copy runtime dependencies for benchmark classpath -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>copy-dependencies</id>
                <phase>package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/dependency</outputDirectory>
                  <includeScope>runtime</includeScope>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <!-- JMH Benchmark Execution -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-shade-plugin</artifactId>
            <version>3.5.1</version>
            <executions>
              <execution>
                <phase>package</phase>
                <goals>
                  <goal>shade</goal>
                </goals>
                <configuration>
                  <finalName>benchmarks</finalName>
                  <createDependencyReducedPom>false</createDependencyReducedPom>
                  <transformers>
                    <transformer
                      implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                      <mainClass>org.openjdk.jmh.Main</mainClass>
                    </transformer>
                    <transformer
                      implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                  </transformers>
                  <filters>
                    <filter>
                      <!-- Exclude signatures to avoid SecurityException -->
                      <artifact>*:*</artifact>
                      <excludes>
                        <exclude>META-INF/*.SF</exclude>
                        <exclude>META-INF/*.DSA</exclude>
                        <exclude>META-INF/*.RSA</exclude>
                      </excludes>
                    </filter>
                  </filters>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
