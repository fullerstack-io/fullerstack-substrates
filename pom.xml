<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.fullerstack</groupId>
  <artifactId>fullerstack-substrates</artifactId>
  <version>3.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Substrates (Java)</name>
  <description>Event-driven runtime implementation of Humainary Substrates API for Java 26
  </description>

  <url>https://github.com/fullerstack-io/fullerstack-substrates</url>

  <properties>
    <!-- Java 26 (required for Substrates API) -->
    <java.version>26</java.version>
    <maven.compiler.source>26</maven.compiler.source>
    <maven.compiler.target>26</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Dependency Versions -->
    <substrates-api.version>3.0.2</substrates-api.version>
    <serventis-api.version>3.0.2</serventis-api.version>
    <junit.version>5.11.0</junit.version>
    <assertj.version>3.26.3</assertj.version>
    <mockito.version>5.15.2</mockito.version>

    <!-- Plugin Versions -->
    <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.1</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
  </properties>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>
        This implementation is based on the Humainary Substrates API designed by William Louth.
        Both this implementation and the Substrates API are licensed under Apache 2.0.
      </comments>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>fullerstack</id>
      <name>Fullerstack</name>
      <url>https://fullerstack.io/</url>
      <roles>
        <role>Implementation</role>
      </roles>
    </developer>
  </developers>

  <contributors>
    <contributor>
      <name>William Louth</name>
      <organization>Humainary</organization>
      <organizationUrl>https://humainary.io/</organizationUrl>
      <roles>
        <role>API Design</role>
        <role>Substrates Framework Creator</role>
      </roles>
    </contributor>
  </contributors>

  <scm>
    <connection>scm:git:git://github.com/fullerstack-io/fullerstack-substrates.git</connection>
    <developerConnection>scm:git:ssh://github.com:fullerstack-io/fullerstack-substrates.git
    </developerConnection>
    <url>https://github.com/fullerstack-io/fullerstack-substrates</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/fullerstack-io/fullerstack-substrates/issues</url>
  </issueManagement>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/fullerstack-io/fullerstack-substrates</url>
    </repository>
  </distributionManagement>

  <dependencies>
    <!-- Substrates API -->
    <dependency>
      <groupId>io.humainary.substrates</groupId>
      <artifactId>humainary-substrates-api</artifactId>
      <version>${substrates-api.version}</version>
    </dependency>

    <!-- Humainary Serventis API -->
    <dependency>
      <groupId>io.humainary.serventis</groupId>
      <artifactId>humainary-serventis-api</artifactId>
      <version>${serventis-api.version}</version>
    </dependency>

    <!-- Logging (SLF4J API only, implementation provided by consumer) -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.16</version>
    </dependency>

    <!-- Lombok (compile-time code generation) -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <version>1.18.34</version>
      <scope>provided</scope>
    </dependency>

    <!-- Vavr (functional data structures) -->
    <dependency>
      <groupId>io.vavr</groupId>
      <artifactId>vavr</artifactId>
      <version>0.10.4</version>
    </dependency>

    <!-- Testing -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>${assertj.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <version>1.15.11</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven-compiler-plugin.version}</version>
        <configuration>
          <source>${java.version}</source>
          <target>${java.version}</target>
          <compilerArgs>
            <arg>--enable-preview</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven-surefire-plugin.version}</version>
        <configuration>
          <argLine>
            --enable-preview
            -XX:+EnableDynamicAgentLoading
            -Dnet.bytebuddy.experimental=true
            --add-opens java.base/java.lang=ALL-UNNAMED
            --add-opens java.base/java.util=ALL-UNNAMED
            --add-opens java.base/java.util.function=ALL-UNNAMED
            --add-opens java.management/javax.management=ALL-UNNAMED
            --add-opens java.management/javax.management.remote=ALL-UNNAMED
            --add-opens java.rmi/sun.rmi.transport=ALL-UNNAMED
          </argLine>
          <systemPropertyVariables>
            <!-- Configure Substrates API to use our FsCortexProvider implementation -->
            <io.humainary.substrates.spi.provider>io.fullerstack.substrates.FsCortexProvider
            </io.humainary.substrates.spi.provider>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
      </plugin>

      <!--
        EditorConfig Formatter (IntelliJ CE formatter via javalint).
        Plugin is configured but NOT bound to a build phase: running every
        mvn install / mvn deploy against the javalint rule set would gate
        publish on dev-style concerns. Lint is available on demand via
        ./scripts/format.sh (check flag) or mvn editorconfig-maven-plugin:check.
      -->
      <plugin>
        <groupId>org.ec4j.maven</groupId>
        <artifactId>editorconfig-maven-plugin</artifactId>
        <version>0.1.3</version>
        <configuration>
          <!-- Disable default linters, use javalint instead -->
          <linters>
            <linter>
              <id>org.ec4j.linters.TextLinter</id>
              <enabled>false</enabled>
            </linter>
            <linter>
              <id>org.ec4j.linters.XmlLinter</id>
              <enabled>false</enabled>
            </linter>
          </linters>
        </configuration>
        <dependencies>
          <!-- javalint: IntelliJ CE formatter with full ij_* EditorConfig support -->
          <dependency>
            <groupId>io.github.kamil-perczynski</groupId>
            <artifactId>javalint-ec4j-linter</artifactId>
            <version>1.3</version>
          </dependency>
        </dependencies>
      </plugin>

    </plugins>
  </build>


</project>
